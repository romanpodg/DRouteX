# Proposed only. Confirm supported feature combinations and deny.toml in P0-04.
name: Rust quality
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: quality-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  format-static-test:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, windows-2025]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - run: rustup toolchain install 1.99.0 --profile minimal --component rustfmt,clippy
      - run: rustup default 1.99.0
      - run: cargo fmt --all -- --check
      - run: cargo check --workspace --all-targets --locked
      # All-features is supplementary; replace with explicit compatible sets if exclusive features exist.
      - run: cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
      - run: cargo test --workspace --locked
      - run: cargo check --workspace --all-targets --no-default-features --locked
      - run: cargo test --workspace --no-default-features --locked
  supply-chain:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - run: rustup toolchain install 1.99.0 --profile minimal
      - run: rustup default 1.99.0
      - run: cargo install cargo-deny --version 0.20.2 --locked
      # Requires a reviewed deny.toml license/advisory/source posture before promotion.
      - run: cargo deny check
