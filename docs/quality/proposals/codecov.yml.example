# Proposed only. Promote to root codecov.yml in P0-04 after real baseline validation.
coverage:
  status:
    project:
      default:
        target: auto
        informational: true
      backend:
        flags: [backend]
        target: auto
        informational: true
      frontend:
        flags: [frontend]
        target: auto
        informational: true
    patch:
      default:
        target: auto
        informational: true
      critical-policy-parsing:
        flags: [backend]
        paths:
          - crates/droutex-policy/
          - crates/droutex-config/
          - crates/droutex-gateway/src/tls_metadata*
          - crates/droutex-gateway/src/origin*
        target: 90%
        threshold: 0%
        informational: false
flags:
  backend:
    paths: [crates/, apps/droutex-server/, apps/droutex-agent/]
    carryforward: false
  frontend:
    paths: [apps/droutex-web/]
    carryforward: false
